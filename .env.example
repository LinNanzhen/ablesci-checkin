# 复制为 .env 后填写；.env 已被 .gitignore 排除。
# 优先级：accounts.json > 本文件中的 ABLESCI_ACCOUNTS_JSON > ABLESCI_ACCOUNTS / ABLESCI_COOKIE

# ── 方式 A（推荐）：JSON，一行一个 Secret，多账号最清晰 ──────────────
# 在 GitHub Secrets 里存成单行即可，中文/空格都没问题：
# ABLESCI_ACCOUNTS_JSON=[{"email":"a@b.com","password":"pw1","cookie":"PHPSESSID=xxx"},{"email":"c@d.com","password":"pw2"}]

# ── 方式 B：邮箱密码，多账号用换行分隔（在 Actions Secret 里直接换行）──
# ABLESCI_ACCOUNTS=a@b.com:pw1
# c@d.com:pw2

# ── 方式 C：只用 Cookie ────────────────────────────────────────────
# ABLESCI_COOKIE=PHPSESSID=xxx; _identity=yyy

# 当 ABLESCI_ACCOUNTS 与 ABLESCI_COOKIE 行数一致时，会一一配对：
# 优先 Cookie，失效自动用对应密码重新登录。

# ── 可选推送（都不填就不推送）────────────────────────────────────
# SERVERCHAN_KEY=xxxxxxxx          # Server酱³
# PUSHPLUS_TOKEN=xxxxxxxx          # PushPlus
# NOTIFY_WEBHOOK=https://...       # 自定义 Webhook（飞书/企业微信/钉钉机器人），POST JSON
# NOTIFY_ON=always                 # always | failure（默认）| never
